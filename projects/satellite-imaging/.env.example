# ==============================================================================
# Satellite Vision Intelligence Platform — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your actual values.
#
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# ==============================================================================

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=satellite_embeddings

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=satellite-images

# --- Model Configuration ---
MODEL_CACHE_DIR=./models
PRITHVI_MODEL_NAME=ibm-nasa-geospatial/Prithvi-100M
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_RELOAD=true

# --- Streamlit ---
API_BASE_URL=http://localhost:8000

# --- MCP Server ---
MCP_SERVER_PORT=8080

# --- Report Generation ---
REPORT_OUTPUT_DIR=./reports
